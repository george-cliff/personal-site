---
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import MainNav from '../components/layout/MainNav.astro';
import SiteLauncher from '../components/layout/SiteLauncher.astro';
import { sectionOf } from '../components/layout/navigation';
import ColourSignature from '../components/ui/ColourSignature.astro';
import { site } from '../data/site';
import '../styles/colours.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title === site.name ? site.name : `${site.name} / ${title}`;
---

<!doctype html>
<html lang="en" data-section={sectionOf(Astro.url.pathname)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      // colours.css themes from data-theme. Restore a saved choice before first
      // paint, then mirror the header's DarkMode toggle, which stores 'darkMode'
      // and announces changes. With nothing saved, the OS preference applies.
      (() => {
        const apply = (dark) => document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
        try {
          const saved = localStorage.getItem('darkMode');
          if (saved) apply(saved === 'enabled');
        } catch {}
        document.addEventListener('darkmode:change', (event) => apply(event.detail.enabled));
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <div class="shell">
      <div class="sidebar">
        <MainNav />
        <div class="signature-sidebar">
          <ColourSignature />
        </div>
      </div>

      <div class="column">
        <header class="site-header">
          <div class="container">
            <Header />
          </div>
        </header>

        <main id="main-content" class="container content" tabindex="-1">
          <slot />
        </main>

        <footer class="site-footer">
          <div class="container">
            <Footer />
            <div class="signature-footer">
              <ColourSignature />
            </div>
          </div>
        </footer>
      </div>
    </div>

    <SiteLauncher />
  </body>
</html>

<style is:global>
  /* Colours come from src/styles/colours.css; use its semantic --color-* roles. */

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  /* Keep focused and linked-to elements clear of the sticky bars. */
  html {
    scroll-padding-top: 4rem;
  }

  /* Tablet: nothing is sticky at the top. Desktop: the header is. */
  @media (min-width: 48rem) {
    html {
      scroll-padding-top: 1rem;
    }
  }

  @media (min-width: 76rem) {
    html {
      scroll-padding-top: 8.5rem;
    }
  }

  body {
    margin: 0;
    background: var(--color-background);
    color: var(--color-text);
    font-family: system-ui, sans-serif;
    line-height: 1.5;
  }

  a {
    color: var(--color-link);
  }

  a:where(:hover, :focus-visible) {
    color: var(--color-link-hover);
  }

  /* Links in page content take the nearest section's colour: the page's, or a
     block's own data-section (e.g. on the homepage). Zero specificity, so
     components that style their own links (nav, badges, cards) keep theirs. */
  :where(.content) a {
    color: var(--color-section);
  }

  :where(.content) a:where(:hover, :focus-visible) {
    color: var(--color-section-strong);
    text-decoration-thickness: 2px;
  }

  :focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  ::selection {
    background: var(--color-interactive);
    color: var(--color-on-interactive);
  }

  /* Hidden visually but still read by screen readers. */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<style>
  .skip-link {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 100;
    padding: 0.5rem 1rem;
    background: var(--color-background);
    color: var(--color-text);
    border: 2px solid currentColor;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  .container {
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  /* Mobile: the nav is a sticky bar above the header. */
  .shell {
    display: grid;
    /* minmax(0, …) lets the scrolling nav row shrink to the viewport. */
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    min-height: 100vh;
  }

  .sidebar {
    position: sticky;
    top: 0;
    z-index: 20;
    padding: 0.25rem 0.5rem;
    background: var(--color-sidebar);
    border-bottom: 1px solid var(--color-border);
  }

  .column {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .site-header {
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .content {
    flex: 1;
    padding-block: 1.5rem;
  }

  .content:focus:not(:focus-visible) {
    outline: none;
  }

  .site-footer {
    padding-block: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  /* One colour signature shows at a time: in the footer on mobile,
     at the foot of the sidebar from tablet up. */
  .signature-sidebar {
    display: none;
  }

  .signature-footer {
    max-width: 20rem;
    margin: 1rem auto 0;
  }

  /* Tablet and up: the nav is a full-height sidebar. */
  @media (min-width: 48rem) {
    .shell {
      grid-template-columns: 13rem minmax(0, 1fr);
      grid-template-rows: auto;
    }

    .sidebar {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      height: 100vh;
      height: 100dvh;
      padding: 1.5rem 1rem;
      /* No overflow scrolling here: it would clip the nav flyouts. */
      border-bottom: 0;
      border-right: 1px solid var(--color-border);
    }

    .signature-sidebar {
      display: block;
      margin-top: auto;
    }

    .signature-footer {
      display: none;
    }

    .container {
      padding-inline: 2rem;
    }
  }

  /* Wide desktop: the one-row header also sticks to the top. */
  @media (min-width: 76rem) {
    .site-header {
      position: sticky;
      top: 0;
      z-index: 10;
      background: var(--color-background);
    }
  }
</style>
