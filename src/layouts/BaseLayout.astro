---
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import MainNav from '../components/layout/MainNav.astro';
import SiteLauncher from '../components/layout/SiteLauncher.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title === site.name ? site.name : `${site.name} / ${title}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <div class="shell">
      <div class="sidebar">
        <MainNav />
      </div>

      <div class="column">
        <header class="site-header">
          <div class="container">
            <Header />
          </div>
        </header>

        <main id="main-content" class="container content" tabindex="-1">
          <slot />
        </main>

        <footer class="site-footer">
          <div class="container">
            <Footer />
          </div>
        </footer>
      </div>
    </div>

    <SiteLauncher />
  </body>
</html>

<style is:global>
  /* Temporary neutral palettes; final colours are still to be decided. */
  :root {
    --color-bg: #ffffff;
    --color-text: #1a1a1a;
    --color-muted: #595959;
    --color-border: #d0d0d0;
    --color-link: #1a1a1a;
  }

  /* Set by Accessible Astro's DarkMode toggle. */
  :root.darkmode {
    --color-bg: #121212;
    --color-text: #ececec;
    --color-muted: #a6a6a6;
    --color-border: #3a3a3a;
    --color-link: #ececec;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  /* Keep focused and linked-to elements clear of the sticky bars. */
  html {
    scroll-padding-top: 4rem;
  }

  /* Tablet: nothing is sticky at the top. Desktop: the header is. */
  @media (min-width: 48rem) {
    html {
      scroll-padding-top: 1rem;
    }
  }

  @media (min-width: 76rem) {
    html {
      scroll-padding-top: 8.5rem;
    }
  }

  body {
    margin: 0;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: system-ui, sans-serif;
    line-height: 1.5;
  }

  a {
    color: var(--color-link);
  }

  :focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  /* Hidden visually but still read by screen readers. */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<style>
  .skip-link {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 100;
    padding: 0.5rem 1rem;
    background: var(--color-bg);
    color: var(--color-text);
    border: 2px solid currentColor;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  .container {
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  /* Mobile: the nav is a sticky bar above the header. */
  .shell {
    display: grid;
    /* minmax(0, …) lets the scrolling nav row shrink to the viewport. */
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    min-height: 100vh;
  }

  .sidebar {
    position: sticky;
    top: 0;
    z-index: 20;
    padding: 0.25rem 0.5rem;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .column {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .site-header {
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .content {
    flex: 1;
    padding-block: 1.5rem;
  }

  .content:focus:not(:focus-visible) {
    outline: none;
  }

  .site-footer {
    padding-block: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  /* Tablet and up: the nav is a full-height sidebar. */
  @media (min-width: 48rem) {
    .shell {
      grid-template-columns: 13rem minmax(0, 1fr);
      grid-template-rows: auto;
    }

    .sidebar {
      height: 100vh;
      height: 100dvh;
      padding: 1.5rem 1rem;
      /* No overflow scrolling here: it would clip the nav flyouts. */
      border-bottom: 0;
      border-right: 1px solid var(--color-border);
    }

    .container {
      padding-inline: 2rem;
    }
  }

  /* Wide desktop: the one-row header also sticks to the top. */
  @media (min-width: 76rem) {
    .site-header {
      position: sticky;
      top: 0;
      z-index: 10;
      background: var(--color-bg);
    }
  }
</style>
