---
import { categories } from '../../data/writing';
import { postUrl, type Post } from '../../lib/writing';
import FormattedDate from '../ui/FormattedDate.astro';

interface Props {
  posts: Post[];
  /** Label each post with its category, for lists that mix categories. */
  showCategory?: boolean;
}

const { posts, showCategory = false } = Astro.props;
---

{posts.length > 0 ? (
  <ul class="posts">
    {posts.map((post) => (
      <li>
        <a href={postUrl(post)}>{post.data.title}</a>
        <span class="meta">
          {post.data.draft && <span>Draft</span>}
          {showCategory && <span>{categories[post.data.category].label}</span>}
          <FormattedDate date={post.data.pubDate} />
        </span>
        <p>{post.data.description}</p>
      </li>
    ))}
  </ul>
) : (
  <p>Coming soon…</p>
)}

<style>
  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1rem;
    padding-block: 0.75rem;
  }

  li + li {
    border-top: 1px solid var(--color-border);
  }

  a {
    font-weight: bold;
    text-underline-offset: 0.2em;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  p {
    flex-basis: 100%;
    margin: 0;
    color: var(--color-text-muted);
  }
</style>
