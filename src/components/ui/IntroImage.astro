---
import type { ImageMetadata } from 'astro';
import { Media } from 'accessible-astro-components';

interface Props {
  /** Local image imported from src/assets; omit to show the placeholder. */
  image?: ImageMetadata;
  /** Meaningful description of the image; required when an image is supplied. */
  alt?: string;
}

const { image, alt = '' } = Astro.props;
---

{image ? (
  <Media class="intro-image" src={image.src} alt={alt} ratio="4:3" loading="eager" />
) : (
  <div class="intro-image intro-image--placeholder" aria-hidden="true"></div>
)}

<style>
  .intro-image {
    border-radius: 0.5rem;
  }

  .intro-image--placeholder {
    aspect-ratio: 4 / 3;
    inline-size: 100%;
    background: var(--color-surface-muted);
    border: 1px solid var(--color-border);
  }
</style>
