---
import { Icon } from 'astro-icon/components';
import type { SocialLink } from '../../data/site';

type Props = SocialLink;

const { label, href, icon, brand } = Astro.props;
---

<a class="badge" href={href} data-brand={brand}>
  <Icon name={icon} class="icon" aria-hidden="true" />
  <span class="label">{label}</span>
</a>

<style>
  .badge {
    /* Boop animation intensity, 1–10. */
    --intensity: 6;

    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding-inline: 1rem;
    border: 1px solid;
    border-radius: 999px;
    color: var(--badge-color, inherit);
    text-decoration: none;
  }

  /* Each badge's own colour; all turn Rose on hover and focus. */
  .badge[data-brand='github'] {
    --badge-color: var(--color-social-github);
  }

  .badge[data-brand='linkedin'] {
    --badge-color: var(--color-social-linkedin);
  }

  .badge[data-brand='email'] {
    --badge-color: var(--color-social-email);
  }

  .badge:is(:hover, :focus-visible) {
    color: var(--color-accent-rose);
    background: var(--color-accent-rose-tint);
  }

  .badge:hover {
    text-decoration: underline;
  }

  .icon {
    width: 1.25em;
    height: 1.25em;
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .badge {
      transition:
        background-color 0.15s ease,
        border-color 0.15s ease,
        color 0.15s ease;
    }

    .badge:is(:hover, :focus-visible) .icon {
      animation: boop 0.4s ease-in-out;
    }
  }

  @keyframes boop {
    50% {
      transform: rotate(calc(var(--intensity) * 2deg)) scale(calc(1 + var(--intensity) * 0.04));
    }
  }
</style>
