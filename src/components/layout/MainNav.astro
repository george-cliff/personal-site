---
import { Icon } from 'astro-icon/components';
import { links } from './navigation';

// Normalise so '/devlog' and '/devlog/' match the same link.
const path = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;

// 'page' for the exact page, 'true' for its section on nested pages.
function current(href: string) {
  if (path === href) return 'page';
  if (href !== '/' && path.startsWith(href)) return 'true';
  return undefined;
}
---

<nav aria-label="Main">
  <ul>
    {links.map(({ label, href, icon }) => (
      <li>
        <a href={href} aria-current={current(href)}>
          <Icon name={icon} class="icon" aria-hidden="true" />
          {label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  /* Mobile: one horizontally scrolling row. Desktop: a vertical list. */
  ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    list-style: none;
  }

  a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    border: 1px solid transparent;
    border-radius: 0.5rem;
    color: inherit;
    text-decoration: none;
    text-underline-offset: 0.25em;
    white-space: nowrap;
  }

  a:hover {
    text-decoration: underline;
  }

  a[aria-current] {
    border-color: var(--color-border);
    font-weight: bold;
  }

  /* Inset so the outline isn't clipped by the scrolling list. */
  a:focus-visible {
    outline-offset: -2px;
  }

  .icon {
    display: none;
    width: 1.25em;
    height: 1.25em;
    flex-shrink: 0;
  }

  @media (min-width: 48rem) {
    ul {
      flex-direction: column;
      overflow-x: visible;
    }

    .icon {
      display: block;
    }
  }
</style>
