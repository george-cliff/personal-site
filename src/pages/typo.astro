---
const fonts = [
  {
    name: "Iosevka",
    description: "Monospaced",
    cssClass: "iosevka",
  },
  {
    name: "Iosevka Aile",
    description: "Proportional sans-serif",
    cssClass: "aile",
  },
  {
    name: "Iosevka Etoile",
    description: "Proportional slab-serif",
    cssClass: "etoile",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Iosevka Typography Comparison</title>
  </head>

  <body>
    <main>
      <header>
        <h1>Typography Explorer</h1>
        <p>Comparing Iosevka 34.9.0 for georgecliff.com</p>
      </header>

      {fonts.map((font) => (
        <section class={font.cssClass}>
          <div class="label">
            <strong>{font.name}</strong>
            <span>{font.description}</span>
          </div>

          <h2>The quick brown fox jumps over the lazy dog.</h2>

          <p>
            Exploring computer architecture, embedded systems,
            signal processing and machine learning.
          </p>

          <p class="medium">
            Medium weight — Projects, Research, Writing
          </p>

          <p class="bold">
            Bold weight — Building things and understanding how they work.
          </p>

          <p>ABCDEFGHIJKLMNOPQRSTUVWXYZ</p>
          <p>abcdefghijklmnopqrstuvwxyz</p>
          <p>0123456789 !@#$%^&amp;*() =&gt; != &amp;&amp;</p>

          <pre><code>{`int main(void) {
    printf("Hello, world!\\n");
    return 0;
}`}</code></pre>
        </section>
      ))}
    </main>
  </body>
</html>

<style>
  @font-face {
    font-family: "Iosevka";
    src: url("/fonts/iosevka/Iosevka-Regular.woff2") format("woff2");
    font-weight: 400;
    font-display: swap;
  }

  @font-face {
    font-family: "Iosevka";
    src: url("/fonts/iosevka/Iosevka-Bold.woff2") format("woff2");
    font-weight: 700;
    font-display: swap;
  }

  @font-face {
    font-family: "Iosevka Aile";
    src: url("/fonts/iosevka-aile/IosevkaAile-Regular.woff2") format("woff2");
    font-weight: 400;
    font-display: swap;
  }

  @font-face {
    font-family: "Iosevka Aile";
    src: url("/fonts/iosevka-aile/IosevkaAile-Medium.woff2") format("woff2");
    font-weight: 500;
    font-display: swap;
  }

  @font-face {
    font-family: "Iosevka Aile";
    src: url("/fonts/iosevka-aile/IosevkaAile-Bold.woff2") format("woff2");
    font-weight: 700;
    font-display: swap;
  }

  @font-face {
    font-family: "Iosevka Etoile";
    src: url("/fonts/iosevka-etoile/IosevkaEtoile-Regular.woff2") format("woff2");
    font-weight: 400;
    font-display: swap;
  }

  @font-face {
    font-family: "Iosevka Etoile";
    src: url("/fonts/iosevka-etoile/IosevkaEtoile-Bold.woff2") format("woff2");
    font-weight: 700;
    font-display: swap;
  }

  body {
    margin: 0;
    background: #f5f5f5;
    color: #222;
    font-family: Arial, sans-serif;
  }

  main {
    max-width: 1000px;
    margin: 0 auto;
    padding: 48px 24px;
  }

  header {
    margin-bottom: 40px;
  }

  section {
    padding: 32px;
    margin-bottom: 24px;
    background: white;
    border: 1px solid #ddd;
    border-radius: 8px;
  }

  .label {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px solid #ddd;
    padding-bottom: 12px;
    margin-bottom: 24px;
  }

  .label span {
    color: #666;
  }

  section h2 {
    font-size: 32px;
    line-height: 1.3;
  }

  section p {
    font-size: 18px;
    line-height: 1.7;
  }

  .medium {
    font-weight: 500;
  }

  .bold {
    font-weight: 700;
  }

  pre {
    overflow-x: auto;
    background: #f1f1f1;
    padding: 16px;
    border-radius: 6px;
  }

  .iosevka {
    font-family: "Iosevka", monospace;
  }

  .aile {
    font-family: "Iosevka Aile", sans-serif;
  }

  .etoile {
    font-family: "Iosevka Etoile", serif;
  }
</style>