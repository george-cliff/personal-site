---
import { Icon } from 'astro-icon/components';
import PostList from '../components/writing/PostList.astro';
import ProjectCard from '../components/projects/ProjectCard.astro';
import IntroImage from '../components/ui/IntroImage.astro';
import { featuredProjects } from '../data/projects';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../lib/writing';

const featured = featuredProjects.slice(0, 2);
const recentPosts = (await getPosts()).slice(0, 5);
---

<BaseLayout title={site.name}>
  <div class="welcome">
    <div>
      <h1>Welcome</h1>
      <p class="intro">
        Welcome to my corner of the internet! Here you can check out
        my <a href="/projects/">projects</a> and <a href="/writing/">writing</a> (both
        technical and casual). The site is still evolving as I learn and
        experiment, so check back often, and feel free
        to <a href="/contact/">reach out</a> if anything looks broken or you just
        want to say hello.
      </p>
    </div>
    <IntroImage />
  </div>

  <section aria-labelledby="workbench" data-section="projects">
    <h2 id="workbench">On the workbench</h2>
    {featured.length > 0 ? (
      <ul class="projects">
        {featured.map((project) => (
          <li>
            <ProjectCard {...project} />
          </li>
        ))}
      </ul>
    ) : (
      <p>Coming soon…</p>
    )}
    <p><a class="more" href="/projects/">All projects<Icon name="tabler:chevrons-right" class="more-icon" aria-hidden="true" /></a></p>
  </section>

  <section aria-labelledby="notebook" data-section="writing">
    <h2 id="notebook">From the notebook</h2>
    <PostList posts={recentPosts} showCategory />
    <p><a class="more" href="/writing/">All writing<Icon name="tabler:chevrons-right" class="more-icon" aria-hidden="true" /></a></p>
  </section>
</BaseLayout>

<style>
  .welcome {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  @media (min-width: 48rem) {
    .welcome {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      gap: 2rem;
    }
  }

  .intro {
    max-width: 40rem;
  }

  section {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  h2 {
    margin-top: 0;
  }

  .more-icon {
    width: 1em;
    height: 1em;
    margin-inline-start: 0.25em;
    vertical-align: -0.125em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .more-icon {
      transition: transform 150ms ease;
    }

    .more:is(:hover, :focus-visible) .more-icon {
      transform: translateX(0.2em);
    }
  }

  .projects {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .projects {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
